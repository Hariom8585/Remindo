# REMINDO - Environment Configuration
# Copy this file to .env and configure your variables

# 1. DATABASE CONFIGURATION (MySQL)
# For local MySQL: mysql://root:YOUR_PASSWORD@localhost:3306/remindo
# For hosted MySQL (PlanetScale/TiDB/Aiven/RDS/Railway):
# DATABASE_URL="mysql://username:password@hostname:3306/remindo?sslaccept=strict"
DATABASE_URL="mysql://root:password@localhost:3306/remindo"

# 2. AUTHENTICATION (JWT Secret for signing sessions)
JWT_SECRET="remindo_production_secure_secret_key_change_me_in_prod_2026"

# 3. AI TASK PARSING (Optional pluggable AI keys)
# If left empty, Remindo automatically uses the deterministic fallback parser
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# 4. APP URL (Used for notifications and callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 5. CRON SCHEDULER AUTHORIZATION SECRET
# Used to secure /api/cron/reminders against unauthorized requests
CRON_SECRET="remindo_cron_scheduler_auth_secret_2026"
